# SecureMed Gateway Environment Configuration
PROJECT_NAME="SecureMed Gateway"
ENVIRONMENT="development"
DEBUG=true

# Database
DATABASE_URL="sqlite:///./securemed.db"

# Security & Cryptography
GATEWAY_IDENTITY_ID="SECUREMED-GW-01"
SESSION_EXPIRATION_SECONDS=3600
RATE_LIMIT_PER_MINUTE=60
REPLAY_WINDOW_SIZE=100

# Firmware Signing
FIRMWARE_STORAGE_PATH="./firmware_storage"
MAX_FIRMWARE_SIZE_BYTES=10485760 # 10 MB

# Admin Credentials (Initial setup)
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="SecureMedAdmin2026!"
ANALYST_DEFAULT_USERNAME="analyst"
ANALYST_DEFAULT_PASSWORD="SecureMedAnalyst2026!"
